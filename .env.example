# Analytics — configure the existing properties, never create new ones for this rebuild.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Keep preview/staging deployments out of search. Set true only for the approved public domain.
SITE_INDEXING_ENABLED=false

# Careers database (same database/schema as the existing careers service).
DATABASE_URL=

# Existing careers application service. Defaults to the current production endpoint.
CAREERS_APPLY_API_URL=https://pleasing-balance-production-708f.up.railway.app/api/Career/apply
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Microsoft Graph application credentials for the initiative inquiry form.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=
